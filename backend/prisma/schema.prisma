// PeopleHub HRM System - Prisma Schema (Sprint 2)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  HR_MANAGER
  MANAGER
  EMPLOYEE
  RECRUITER
}

enum EmployeeStatus {
  PROBATION
  ACTIVE
  SUSPENDED
  TERMINATED
  RESIGNED
  RETIRED
  ON_LEAVE
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EARLY_LEAVE
  HALF_DAY
  ON_LEAVE
  REMOTE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveTypeCategory {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  UNPAID
  COMPENSATORY
  BEREAVEMENT
  MARRIAGE
  CUSTOM
}

enum ShiftType {
  FIXED
  ROTATING
  FLEXIBLE
  CUSTOM
}

enum HolidayType {
  PUBLIC
  COMPANY
  DEPARTMENT
  OPTIONAL
}

enum CheckInOutType {
  CHECK_IN
  CHECK_OUT
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

// ============================================================
// PAYROLL ENUMS
// ============================================================

enum SalaryComponentType {
  BASE
  ALLOWANCE
  DEDUCTION
  BONUS
}

enum PayPeriodType {
  MONTHLY
  BIWEEKLY
  WEEKLY
}

enum PayPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum PayrollRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSED
  PAID
  FAILED
}

enum PayslipStatus {
  DRAFT
  ISSUED
  VIEWED
}

// ============================================================
// MULTI-TENANCY
// ============================================================

model Tenant {
  id           String       @id @default(uuid())
  name         String
  slug         String       @unique
  domain       String?      @unique
  logo         String?
  timezone     String       @default("UTC")
  language     String       @default("en")
  currency     String       @default("USD")
  isActive     Boolean      @default(true)
  plan         String       @default("FREE")
  maxEmployees Int          @default(10)
  settings     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users        User[]
  departments  Department[]
  positions    Position[]
  employees    Employee[]
  leaveTypes   LeaveType[]
  shifts       Shift[]
  holidays     Holiday[]
  salaryComponents SalaryComponent[]
  taxRules     TaxRule[]
  payPeriods   PayPeriod[]
  payrollRuns  PayrollRun[]
  payslips     Payslip[]
}

// ============================================================
// USER & AUTH
// ============================================================

model User {
  id             String     @id @default(uuid())
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  email          String
  emailVerified  Boolean    @default(false)
  passwordHash   String?
  mfaEnabled     Boolean    @default(false)
  mfaSecret      String?
  mfaBackupCodes String[]
  role           UserRole   @default(EMPLOYEE)
  isActive       Boolean    @default(true)
  lastLoginAt    DateTime?
  lastLoginIp    String?
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?
  settings       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  employee       Employee?
  sessions       Session[]
  refreshTokens  RefreshToken[]
  managedDepartments Department[] @relation("DepartmentManager")
  createdPayrollRuns PayrollRun[]  @relation("PayrollRunCreator")
  approvedPayrollRuns PayrollRun[] @relation("PayrollRunApprover")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  deviceName String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// ============================================================
// ORGANIZATION
// ============================================================

model Department {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  name        String
  code        String?
  description String?
  parentId    String?
  parent      Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")
  managerId   String?
  manager     User?        @relation("DepartmentManager", fields: [managerId], references: [id])
  budget      Decimal?     @db.Decimal(15, 2)
  costCenter  String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employees   Employee[]
  positions   Position[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Position {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  title        String
  code         String?
  description  String?
  level        Int        @default(1)
  minSalary    Decimal?   @db.Decimal(15, 2)
  maxSalary    Decimal?   @db.Decimal(15, 2)
  headcount    Int        @default(1)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employees    Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// ============================================================
// EMPLOYEE
// ============================================================

model Employee {
  id               String         @id @default(uuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  userId           String?        @unique
  user             User?          @relation(fields: [userId], references: [id])
  employeeCode     String         @unique
  firstName        String
  lastName         String
  displayName      String?
  email            String
  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  maritalStatus    String?
  nationality      String?
  address          String?
  city             String?
  state            String?
  country          String         @default("VN")
  postalCode       String?
  profilePhoto     String?
  status           EmployeeStatus @default(PROBATION)
  departmentId     String?
  department       Department?    @relation(fields: [departmentId], references: [id])
  positionId       String?
  position         Position?      @relation(fields: [positionId], references: [id])
  managerId        String?
  manager          Employee?      @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  directReports    Employee[]     @relation("EmployeeHierarchy")
  hireDate         DateTime?
  probationEndDate DateTime?
  terminationDate  DateTime?
  terminationReason String?
  bankName         String?
  bankAccount      String?
  taxCode          String?
  contractType     ContractType?
  salary           Decimal?       @db.Decimal(15, 2)
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  notes            String?
  isDeleted        Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@index([tenantId, isDeleted])
  @@index([employeeCode])

  attendanceLogs    AttendanceLog[]
  shiftAssignments  ShiftAssignment[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]        @relation("LeaveRequestEmployee")
  approvedLeaves    LeaveRequest[]        @relation("LeaveRequestApprover")
  salaryComponents  SalaryComponent[]
  payrollRecords    PayrollRecord[]
  payslips          Payslip[]
}

// ============================================================
// SHIFT MANAGEMENT
// ============================================================

model Shift {
  id              String     @id @default(uuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id])
  name            String
  code            String?
  description     String?
  type            ShiftType  @default(FIXED)
  startTime       String     // "09:00"
  endTime         String     // "18:00"
  breakStart      String?    // "12:00"
  breakEnd        String?    // "13:00"
  breakMinutes    Int        @default(60)
  workHours       Float      @default(8.0)
  lateThreshold   Int        @default(15)  // minutes before considered late
  earlyLeaveThreshold Int    @default(15)  // minutes before considered early leave
  color           String?    // UI color hex
  isActive        Boolean    @default(true)
  isDefault       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  assignments     ShiftAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model ShiftAssignment {
  id          String   @id @default(uuid())
  tenantId    String
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  shiftId     String
  shift       Shift    @relation(fields: [shiftId], references: [id])
  startDate   DateTime // effective start date
  endDate     DateTime? // null = ongoing
  dayOfWeek   Int?     // 0=Sun, 1=Mon... for rotating shifts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, shiftId, startDate])
  @@index([tenantId])
  @@index([employeeId])
  @@index([shiftId])
}

// ============================================================
// ATTENDANCE
// ============================================================

model AttendanceLog {
  id              String           @id @default(uuid())
  tenantId        String
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  date            DateTime         // date-only (truncated)
  checkInTime     DateTime?
  checkOutTime    DateTime?
  type            CheckInOutType   @default(CHECK_IN)
  status          AttendanceStatus @default(PRESENT)
  workHours       Float?           // calculated worked hours
  lateMinutes     Int              @default(0)
  earlyLeaveMinutes Int            @default(0)
  overtimeMinutes Int              @default(0)
  ipAddress       String?
  location        String?          // GPS or location name
  notes           String?
  shiftId         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([tenantId])
  @@index([employeeId])
  @@index([date])
  @@index([tenantId, date])
  @@index([employeeId, date])
}

// ============================================================
// LEAVE MANAGEMENT
// ============================================================

model LeaveType {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  name            String
  category        LeaveTypeCategory @default(ANNUAL)
  description     String?
  color           String?           // UI color
  icon            String?
  annualDays      Float             @default(0)  // days per year
  accrualRate     Float             @default(0)  // days per month
  carryOverLimit  Float             @default(0)  // max days carried over
  carryOverExpiry String?           // "03-31" means expires March 31
  maxConsecutiveDays Int?           // max consecutive days allowed
  requiresAttachment Boolean        @default(false)
  requiresReason  Boolean           @default(true)
  unpaid          Boolean           @default(false)
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  balances        LeaveBalance[]
  leaveRequests   LeaveRequest[]

  @@unique([tenantId, category])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model LeaveBalance {
  id              String    @id @default(uuid())
  tenantId        String
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId     String
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  year            Int       // balance year
  totalAccrued    Float     @default(0)  // total earned this year
  used            Float     @default(0)  // total used this year
  carriedOver     Float     @default(0)  // carried from previous year
  adjusted        Float     @default(0)  // manual adjustments
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([tenantId])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model LeaveRequest {
  id              String      @id @default(uuid())
  tenantId        String
  employeeId      String
  employee        Employee    @relation("LeaveRequestEmployee", fields: [employeeId], references: [id])
  leaveTypeId     String
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime
  endDate         DateTime
  startHalfDay    Boolean     @default(false)  // first half day
  endHalfDay      Boolean     @default(false)  // last half day
  reason          String
  attachmentUrl   String?
  status          LeaveStatus @default(PENDING)
  totalDays       Float       // calculated business days
  approverId      String?
  approver        Employee?   @relation("LeaveRequestApprover", fields: [approverId], references: [id])
  approvalDate    DateTime?
  approvalComment String?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([tenantId, status])
  @@index([approverId])
}

// ============================================================
// HOLIDAYS
// ============================================================

model Holiday {
  id              String      @id @default(uuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  name            String
  description     String?
  date            DateTime    // holiday date
  type            HolidayType @default(PUBLIC)
  isRecurring     Boolean     @default(false) // repeats yearly
  departmentId    String?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([tenantId, date, name])
  @@index([tenantId])
  @@index([date])
  @@index([tenantId, isActive])
}

// ============================================================
// PAYROLL & COMPENSATION
// ============================================================

model SalaryComponent {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  employeeId    String
  employee      Employee             @relation(fields: [employeeId], references: [id])
  type          SalaryComponentType
  name          String               // e.g. "Base Salary", "Meal Allowance", "Housing Allowance"
  amount        Decimal              @db.Decimal(15, 2)
  effectiveDate DateTime             // when this component takes effect
  isActive      Boolean              @default(true)
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, type])
  @@index([tenantId, employeeId, type])
}

model TaxRule {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String   // e.g. "Personal Income Tax 2026"
  bracket       Int      // bracket order (1, 2, 3...)
  rate          Decimal  @db.Decimal(5, 4) // e.g. 0.05 for 5%
  threshold     Decimal  @db.Decimal(15, 2) // minimum income for this bracket
  ceiling       Decimal? @db.Decimal(15, 2) // max income for this bracket (null = no ceiling)
  description   String?
  effectiveFrom DateTime @default(now())
  effectiveTo   DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name, bracket])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

model PayPeriod {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  type        PayPeriodType  @default(MONTHLY)
  year        Int
  period      Int            // 1-12 for monthly, 1-26 for biweekly, 1-52 for weekly
  startDate   DateTime
  endDate     DateTime
  cutoffDate  DateTime       // last date for changes to be included
  status      PayPeriodStatus @default(OPEN)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  payrollRuns PayrollRun[]

  @@unique([tenantId, type, year, period])
  @@index([tenantId])
  @@index([tenantId, year, period])
  @@index([tenantId, status])
}

model PayrollRun {
  id              String           @id @default(uuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  payPeriodId     String
  payPeriod       PayPeriod        @relation(fields: [payPeriodId], references: [id])
  status          PayrollRunStatus @default(DRAFT)
  createdBy       String           // userId
  createdByUser   User             @relation("PayrollRunCreator", fields: [createdBy], references: [id])
  approvedBy      String?          // userId
  approvedByUser  User?            @relation("PayrollRunApprover", fields: [approvedBy], references: [id])
  processedAt     DateTime?
  notes           String?
  totalGrossPay   Decimal?         @db.Decimal(18, 2)
  totalNetPay     Decimal?         @db.Decimal(18, 2)
  totalDeductions Decimal?         @db.Decimal(18, 2)
  totalAllowances Decimal?         @db.Decimal(18, 2)
  totalTax        Decimal?         @db.Decimal(18, 2)
  totalInsurance  Decimal?         @db.Decimal(18, 2)
  totalEmployerCost Decimal?       @db.Decimal(18, 2) // employer insurance contribution
  employeeCount   Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  records         PayrollRecord[]

  @@index([tenantId])
  @@index([payPeriodId])
  @@index([tenantId, status])
}

model PayrollRecord {
  id                String   @id @default(uuid())
  tenantId          String
  payrollRunId      String
  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id])
  grossPay          Decimal  @db.Decimal(15, 2)
  netPay            Decimal  @db.Decimal(15, 2)
  totalDeductions   Decimal  @db.Decimal(15, 2)
  totalAllowances   Decimal  @db.Decimal(15, 2)
  taxAmount         Decimal  @db.Decimal(15, 2)
  insuranceEmployee Decimal  @db.Decimal(15, 2) // employee insurance contribution
  insuranceEmployer Decimal  @db.Decimal(15, 2) // employer insurance contribution
  overtimePay       Decimal  @db.Decimal(15, 2) @default(0)
  baseSalary        Decimal  @db.Decimal(15, 2)
  bonusAmount       Decimal  @db.Decimal(15, 2) @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  payslip           Payslip?

  @@unique([payrollRunId, employeeId])
  @@index([tenantId])
  @@index([payrollRunId])
  @@index([employeeId])
}

model Payslip {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  payrollRecordId String     @unique
  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id])
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id])
  pdfPath       String?      // MinIO object key
  issuedDate    DateTime     @default(now())
  status        PayslipStatus @default(DRAFT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId])
  @@index([employeeId])
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
}
