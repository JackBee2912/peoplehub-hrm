# PeopleHub HRM - Environment Configuration

# Database
DATABASE_URL=postgresql://peoplehub:peoplehub_secret@postgres:5432/peoplehub?schema=public
POSTGRES_USER=peoplehub
POSTGRES_PASSWORD=peoplehub_secret
POSTGRES_DB=peoplehub

# Redis
REDIS_URL=redis://redis:6379

# JWT (RS256)
JWT_ACCESS_SECRET_PATH=/app/config/jwtRS256.pem
JWT_REFRESH_SECRET_PATH=/app/config/jwtRS256.key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# App
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
BCRYPT_SALT_ROUNDS=10

# CORS
CORS_ORIGIN=http://localhost:5174

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# MinIO (Object Storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=peoplehub
MINIO_USE_SSL=false
