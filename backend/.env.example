# Server
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://peoplehub:peoplehub_secret@localhost:5432/peoplehub?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET_PATH=./config/jwtRS256.pem
JWT_REFRESH_SECRET_PATH=./config/jwtRS256.key
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# CORS
CORS_ORIGIN=http://localhost:5173

# Throttler
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# MinIO (future)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=peoplehub
MINIO_USE_SSL=false
